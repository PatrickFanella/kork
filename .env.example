# Public origin of the service (where /app and /{slug} live).
ZELDA_BASE_URL=https://links.example.com
# Hostname part of ZELDA_BASE_URL, used by Caddy.
ZELDA_HOST=links.example.com
# Hostname custom domains CNAME to; defaults to the BASE_URL host.
ZELDA_DOMAIN_TARGET=links.example.com
ZELDA_APP_NAME=Zelda
POSTGRES_PASSWORD=change-me
# Behind Caddy: use X-Forwarded-For for rate limits.
ZELDA_TRUST_PROXY=true
# Email for verification and password reset. Without SMTP, links are only logged.
ZELDA_SMTP_HOST=
ZELDA_SMTP_PORT=587
ZELDA_SMTP_USER=
ZELDA_SMTP_PASSWORD=
ZELDA_MAIL_FROM="Zelda <no-reply@example.com>"
# Email for Let's Encrypt account notices.
ACME_EMAIL=admin@example.com
