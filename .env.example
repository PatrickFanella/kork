# Public origin of the service (where /app and /{slug} live).
ZELDA_BASE_URL=https://links.example.com
# Hostname part of ZELDA_BASE_URL, used by Caddy.
ZELDA_HOST=links.example.com
# Hostname custom domains CNAME to; defaults to the BASE_URL host.
ZELDA_DOMAIN_TARGET=links.example.com
ZELDA_APP_NAME=Kork
POSTGRES_PASSWORD=change-me
# Admin accounts, granted once the email is verified (comma-separated).
ZELDA_ADMIN_EMAILS=you@example.com
# Needs on-demand TLS in front (deploy/Caddyfile). Set false behind a proxy that can't serve arbitrary hostnames.
ZELDA_CUSTOM_DOMAINS=true
# Behind Caddy: use X-Forwarded-For for rate limits.
ZELDA_TRUST_PROXY=true
# Email for verification and password reset. Without SMTP, links are only logged.
ZELDA_SMTP_HOST=
ZELDA_SMTP_PORT=587
ZELDA_SMTP_USER=
ZELDA_SMTP_PASSWORD=
ZELDA_MAIL_FROM="Zelda <no-reply@example.com>"
# Days of aggregate stats to keep (minimum 30). The editor shows up to 30.
ZELDA_STATS_RETENTION_DAYS=400
# Pages a Free account can create (Pro gets 25).
ZELDA_FREE_PAGE_LIMIT=5
# Email for Let's Encrypt account notices.
ACME_EMAIL=admin@example.com
# Link screening (see README "Abuse controls"). With none set, links are not screened.
ZELDA_SAFE_BROWSING_KEY=
# In Docker, /data/blocklist.txt keeps a downloaded feed across restarts.
ZELDA_BLOCKLIST_FILE=
ZELDA_BLOCKLIST_URL=
# New accounts can publish after this long unless an admin approves them; 0 disables.
ZELDA_PUBLISH_MIN_ACCOUNT_AGE=24h
# 32-byte key that encrypts creators' Brevo API keys for email sign-up blocks.
# Generate with: openssl rand -base64 32. Without it, sign-up lists can only be kept in Kork.
# Changing it makes saved Brevo keys unreadable; creators then have to enter them again.
ZELDA_SECRET_KEY=
# Contact address shown on /terms and /privacy for questions and data requests.
ZELDA_CONTACT_EMAIL=hello@subcult.tv
